# =====================
# Internal collateral / data — keep out of git
# =====================
# Pitch decks, briefs, market reports, audits as binaries — anchored to repo
# root so we don't accidentally exclude legitimate /frontend/public/*.docx assets
# that don't currently exist but might later.
/*.docx
/*.pptx
/*.html
/CivicGuards-*.html

# Personal photos used as ad-hoc test fixtures
/*.jpeg
/*.jpg

# Production database dumps — never commit
/data-dump.sql
/data-ordered.sql
/*.dump
/*.sql.gz

# Random root-level PDFs (briefs, internal task lists)
/irina*.pdf

# Grant / award application materials — kept locally, never in repo
/report finance/

# Raw team photos — the canonical assets live under frontend/public/team/
# as compressed WebP. Originals stay local for re-export only.
/team-photos/

# Local Claude Code session state
.claude/

# graphify knowledge graph output (regenerated on demand)
graphify-out/

# Playwright test artifacts
.playwright-mcp/
frontend/test-results/
frontend/playwright-report/
