# =============================================================================
# ArtiProof — environment variables template
# =============================================================================
# Copy this file to .env (and frontend/.env.local for the Next.js app) and fill
# in real values. Do NOT commit any file containing real secrets.
# Generate strong random values with:
#     openssl rand -hex 32          # JWT_SECRET
#     openssl rand -base64 32       # NEXTAUTH_SECRET
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# One of: development | staging | production.
# Behavior gated by this value:
#   - /api/seed/* endpoints return 403 in production.
#   - JWT_SECRET is hard-required in production (the backend refuses to start).
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# The backend (FastAPI) uses the asyncpg URL; the frontend (Prisma) uses the sync URL.
DATABASE_URL=postgresql+asyncpg://artiproof:artiproof@localhost:5432/artiproof
DATABASE_URL_SYNC=postgresql://artiproof:artiproof@localhost:5432/artiproof

# Neon — only required when running the data-import shell scripts in repo root.
NEON_HOST=
NEON_PORT=5432
NEON_USER=
NEON_PASSWORD=
NEON_DB=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# REDIS_PASSWORD is consumed by docker-compose to start Redis with auth.
# REDIS_URL must include the same password.
REDIS_PASSWORD=artiproof-redis-dev
REDIS_URL=redis://:artiproof-redis-dev@localhost:6379/0

# -----------------------------------------------------------------------------
# NextAuth (frontend)
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-strong-random-value

# -----------------------------------------------------------------------------
# OAuth providers
# -----------------------------------------------------------------------------
# Google: https://console.cloud.google.com/apis/credentials
# The client ID is also used by the backend to verify Google ID tokens.
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Backend JWT (FastAPI)
# -----------------------------------------------------------------------------
# REQUIRED in production — the backend will refuse to start with the default value.
JWT_SECRET=replace-with-strong-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# -----------------------------------------------------------------------------
# AI / fact-checking integrations (optional)
# -----------------------------------------------------------------------------
# Each integration is feature-flagged: empty values disable the feature
# instead of crashing the backend.
# LLM provider selection (Phase 9). Defaults to gemini for back-compat.
# Set LLM_PROVIDER to one of: gemini | openai | anthropic to switch
# which vendor every analysis engine routes through.
# Set LLM_FALLBACK_PROVIDER to a different provider name to enable
# automatic failover when the primary fails 3× consecutively within
# a 5-minute window (an empty fallback disables that path).
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# OpenAI — empty key disables the provider. ChatGPT API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Anthropic — empty key disables the provider. Claude API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

GOOGLE_FACTCHECK_API_KEY=
SCOPUS_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# -----------------------------------------------------------------------------
# App URLs / CORS
# -----------------------------------------------------------------------------
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# CORS_ORIGINS is comma-separated; APP_URL is always allowed.
# Set CORS_ORIGIN_REGEX to allow preview/branch deploys — pin to your project
# slug rather than all of *.vercel.app, e.g.
#   CORS_ORIGIN_REGEX=https://artiproof-[a-z0-9-]+\.vercel\.app
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# CORS_ORIGIN_REGEX=

# -----------------------------------------------------------------------------
# Outbound HTTP politeness (CrossRef / OpenAlex / etc.)
# -----------------------------------------------------------------------------
CONTACT_EMAIL=info@artiproof.com

# -----------------------------------------------------------------------------
# Email delivery (Resend)
# -----------------------------------------------------------------------------
# Resend dashboard: https://resend.com/api-keys
# - RESEND_API_KEY empty → backend logs the email instead of sending. Fine for
#   local dev; in production, leaving this empty silently disables password
#   reset, email verification, and scheduled report delivery.
# - EMAIL_FROM must be a verified sender in your Resend dashboard. Use the
#   `Name <addr>` format so client previews show a friendly From.
RESEND_API_KEY=
EMAIL_FROM=ArtiProof <noreply@artiproof.com>

# -----------------------------------------------------------------------------
# Observability (Sentry)
# -----------------------------------------------------------------------------
# https://sentry.io → Project → Settings → Client Keys (DSN)
# - SENTRY_DSN empty → no error tracking at all. Production should always set this.
# - SENTRY_ENVIRONMENT defaults to ENVIRONMENT when empty; override only if you
#   want a non-standard tag (e.g. "prod-eu" for a regional deploy).
# - SENTRY_TRACES_SAMPLE_RATE controls perf-trace sampling. 0.05 = 5% of
#   requests get a trace; raise to 0.5+ only during active perf debugging.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.05

# -----------------------------------------------------------------------------
# Scheduled-reports beat
# -----------------------------------------------------------------------------
# Hour of UTC at which the daily sweep fires due weekly/monthly report
# schedules. Default 9 (09:00 UTC) — keeps deliveries predictable. Read by
# app/tasks/scheduled_reports.py at Celery-beat startup.
REPORT_SWEEP_HOUR_UTC=9

# -----------------------------------------------------------------------------
# Demo seeding (development only)
# -----------------------------------------------------------------------------
# /api/seed/demo is gated by BOTH:
#   1. ENABLE_SEED_ROUTES (default false) — must be explicitly true.
#   2. ENVIRONMENT != production (hard rule, ignores the flag).
# DEMO_EMAIL / DEMO_PASSWORD are only consumed when seeding is allowed.
ENABLE_SEED_ROUTES=false
DEMO_EMAIL=demo@artiproof.com
DEMO_PASSWORD=demo1234
