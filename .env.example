NEXTAUTH_SECRET=replace-with-a-different-random-local-only-value
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GEMINI_API_KEY=
OPENAI_API_KEY=
