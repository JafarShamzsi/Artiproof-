# Synthetic local-review template only. The backend uses process environment,
# not automatic dotenv loading. Set variables in your terminal; never add keys.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://showcase:showcase@localhost:55439/showcase
DATABASE_URL_SYNC=postgresql://showcase:showcase@localhost:55439/showcase
